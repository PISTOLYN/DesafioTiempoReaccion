<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DesafioTiempoReaccion</RootNamespace>
    <AssemblyName>DesafioTiempoReaccion</AssemblyName>
    <Version>2.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ignora la versión vieja que quedó en src/Ui -->
    <Compile Remove="Ui\**" />
    <Page Remove="Ui\**" />
    <None Remove="Ui\**" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>
</Project>
