<Window x:Class="DesafioTiempoReaccion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desafío Tiempo de Reacción Challenge" Width="1280" Height="830"
        WindowStartupLocation="CenterScreen" Background="#040A1C"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="Lcd" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="DS-Digital, Consolas"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#7CFF2A"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Impact, Arial Narrow"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="MenuBtn" TargetType="Button">
      <Setter Property="Height" Value="46"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#12306B"/>
      <Setter Property="BorderBrush" Value="#2E8CFF"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="Arrow" TargetType="Button">
      <Setter Property="Width" Value="50"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Viewbox Stretch="Uniform">
      <Canvas Width="1560" Height="1010">
        <Canvas.Background>
          <RadialGradientBrush Center="0.5,0.1" RadiusX="1" RadiusY="1">
            <GradientStop Color="#16348A" Offset="0"/>
            <GradientStop Color="#071238" Offset="0.6"/>
            <GradientStop Color="#030813" Offset="1"/>
          </RadialGradientBrush>
        </Canvas.Background>

        <!-- Marcador ROJO -->
        <TextBlock Canvas.Left="80" Canvas.Top="28" Width="265" Text="PUNTO" Style="{StaticResource Lbl}" FontSize="34"/>
        <Border Canvas.Left="80" Canvas.Top="75" Width="265" Height="100" CornerRadius="8" BorderThickness="4"
                BorderBrush="#FF4040" Background="#8E0A0A">
          <TextBlock x:Name="ScoreRojo" Text="0" Style="{StaticResource Lbl}" FontSize="80"/>
        </Border>

        <!-- Marcador AZUL -->
        <TextBlock Canvas.Left="1215" Canvas.Top="28" Width="265" Text="PUNTO" Style="{StaticResource Lbl}" FontSize="34"/>
        <Border Canvas.Left="1215" Canvas.Top="75" Width="265" Height="100" CornerRadius="8" BorderThickness="4"
                BorderBrush="#3FA0FF" Background="#0B2E9E">
          <TextBlock x:Name="ScoreAzul" Text="0" Style="{StaticResource Lbl}" FontSize="80"/>
        </Border>

        <!-- Título -->
        <StackPanel Canvas.Left="380" Canvas.Top="5" Width="800">
          <TextBlock Text="DESAFÍO" Style="{StaticResource Lbl}" FontSize="110" FontStyle="Italic"/>
          <TextBlock x:Name="TitleModo" Text="TIEMPO DE REACCIÓN" Style="{StaticResource Lbl}" Foreground="#FFD21F"
                     FontSize="62" FontStyle="Italic" Margin="0,-25,0,0"/>
          <TextBlock Text="CHALLENGE" Style="{StaticResource Lbl}" FontSize="78" FontStyle="Italic" Margin="0,-18,0,0"/>
        </StackPanel>

        <!-- Panel ROJO -->
        <Border Canvas.Left="10" Canvas.Top="185" Width="540" Height="800" CornerRadius="45" BorderThickness="6" BorderBrush="#FF3030">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#7A0A0A" Offset="0"/><GradientStop Color="#2A0505" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="110"/><RowDefinition Height="200"/><RowDefinition Height="*"/><RowDefinition Height="90"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="25,25,25,5" CornerRadius="10" Background="#B01010" BorderBrush="#FF6060" BorderThickness="3">
              <TextBlock Text="EQUIPO ROJO" Style="{StaticResource Lbl}" FontSize="60"/>
            </Border>
            <Border Grid.Row="1" Margin="25,10" Background="#050505" BorderBrush="#FF3030" BorderThickness="4" CornerRadius="12">
              <TextBlock x:Name="DispRojo" Text="00.00" Style="{StaticResource Lcd}" FontSize="130"/>
            </Border>
            <Grid Grid.Row="2" x:Name="BtnRojo" Width="320" Height="320" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="BtnRojo_Down">
              <Ellipse Fill="#BBBBBB"/>
              <Ellipse Margin="10" Fill="#333333"/>
              <Ellipse Margin="22">
                <Ellipse.Fill>
                  <RadialGradientBrush GradientOrigin="0.35,0.3">
                    <GradientStop Color="#FF9A8A" Offset="0"/><GradientStop Color="#FF1A1A" Offset="0.4"/><GradientStop Color="#A80000" Offset="1"/>
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
            </Grid>
            <Border Grid.Row="3" Margin="40,10,40,25" CornerRadius="8" Background="#A00D0D" BorderBrush="#FF5050" BorderThickness="3">
              <TextBlock x:Name="StatusRojo" Text="PRESIONA EL BOTÓN" Style="{StaticResource Lbl}" FontSize="34"/>
            </Border>
          </Grid>
        </Border>

        <!-- Panel AZUL -->
        <Border Canvas.Left="1010" Canvas.Top="185" Width="540" Height="800" CornerRadius="45" BorderThickness="6" BorderBrush="#3FA0FF">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#0A2A8A" Offset="0"/><GradientStop Color="#050E2E" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="110"/><RowDefinition Height="200"/><RowDefinition Height="*"/><RowDefinition Height="90"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="25,25,25,5" CornerRadius="10" Background="#0F3BC0" BorderBrush="#60B4FF" BorderThickness="3">
              <TextBlock Text="EQUIPO AZUL" Style="{StaticResource Lbl}" FontSize="60"/>
            </Border>
            <Border Grid.Row="1" Margin="25,10" Background="#050505" BorderBrush="#3FA0FF" BorderThickness="4" CornerRadius="12">
              <TextBlock x:Name="DispAzul" Text="00.00" Style="{StaticResource Lcd}" FontSize="130"/>
            </Border>
            <Grid Grid.Row="2" x:Name="BtnAzul" Width="320" Height="320" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="BtnAzul_Down">
              <Ellipse Fill="#BBBBBB"/>
              <Ellipse Margin="10" Fill="#333333"/>
              <Ellipse Margin="22">
                <Ellipse.Fill>
                  <RadialGradientBrush GradientOrigin="0.35,0.3">
                    <GradientStop Color="#9AC8FF" Offset="0"/><GradientStop Color="#1A5CFF" Offset="0.4"/><GradientStop Color="#0A2AA8" Offset="1"/>
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
            </Grid>
            <Border Grid.Row="3" Margin="40,10,40,25" CornerRadius="8" Background="#0D3AA0" BorderBrush="#5AA8FF" BorderThickness="3">
              <TextBlock x:Name="StatusAzul" Text="PRESIONA EL BOTÓN" Style="{StaticResource Lbl}" FontSize="34"/>
            </Border>
          </Grid>
        </Border>

        <!-- Centro -->
        <Border Canvas.Left="590" Canvas.Top="300" Width="380" Height="60" CornerRadius="8" Background="#0A2A6E" BorderBrush="#2E8CFF" BorderThickness="3">
          <TextBlock x:Name="LblModo" Text="TIEMPO DE REACCIÓN" Style="{StaticResource Lbl}" FontSize="32"/>
        </Border>
        <Border Canvas.Left="590" Canvas.Top="370" Width="380" Height="140" CornerRadius="12" Background="#050505" BorderBrush="#2E8CFF" BorderThickness="4">
          <TextBlock x:Name="DispCentro" Text="10.00" Style="{StaticResource Lcd}" FontSize="100"/>
        </Border>
        <Border x:Name="CenterBox" Canvas.Left="590" Canvas.Top="530" Width="380" Height="270" CornerRadius="12"
                Background="#06143A" BorderBrush="#2E8CFF" BorderThickness="3">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="⏱" FontSize="64" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock x:Name="MsgCentro" Text="" Style="{StaticResource Lbl}" FontSize="30" TextWrapping="Wrap" Margin="12,0"/>
          </StackPanel>
        </Border>

        <!-- Selector de modo -->
        <TextBlock Canvas.Left="590" Canvas.Top="825" Width="380" Text="⚙ MODO DE JUEGO" Style="{StaticResource Lbl}" FontSize="26"/>
        <Border Canvas.Left="590" Canvas.Top="870" Width="380" Height="60" CornerRadius="8" Background="#0A2A6E" BorderBrush="#2E8CFF" BorderThickness="3">
          <Grid>
            <Button Content="◀" Style="{StaticResource Arrow}" HorizontalAlignment="Left" Click="ModoPrev_Click" Focusable="False"/>
            <TextBlock x:Name="ModoTxt" Text="TIEMPO DE REACCIÓN" Style="{StaticResource Lbl}" FontSize="26"/>
            <Button Content="▶" Style="{StaticResource Arrow}" HorizontalAlignment="Right" Click="ModoNext_Click" Focusable="False"/>
          </Grid>
        </Border>
      </Canvas>
    </Viewbox>

    <!-- Menú (tecla M) -->
    <Grid x:Name="MenuOverlay" Visibility="Collapsed" Background="#D0000000">
      <Border Width="560" MaxHeight="760" CornerRadius="18" Background="#0B1B45" BorderBrush="#2E8CFF" BorderThickness="4" Padding="22"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="MenuTitle" Text="MENÚ" Style="{StaticResource Lbl}" FontSize="40" Margin="0,0,0,10"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
            <StackPanel x:Name="MenuStack"/>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
