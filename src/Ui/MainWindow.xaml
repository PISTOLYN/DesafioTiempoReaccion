        <!-- MENÚ DE CONFIGURACIÓN -->
        <Grid x:Name="PantallaConfig" Background="#EE020205" Panel.ZIndex="200" Visibility="Collapsed">
            <Border Background="#0A0A1A" BorderBrush="#39FF14" BorderThickness="3" CornerRadius="20" Width="800" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="40">
                    <TextBlock Text="CONFIGURACIÓN" Foreground="#39FF14" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,30" FontWeight="Bold"/>
                    
                    <TextBlock Text="Título del Desafío:" Foreground="White" FontSize="22"/>
                    <TextBox Text="{Binding TituloDesafio, UpdateSourceTrigger=PropertyChanged}" FontSize="22" Margin="0,5,0,20" Background="#111" Foreground="White"/>

                    <TextBlock Text="Haz clic en un botón y luego presiona tu botón físico USB:" Foreground="Gray" FontSize="18" Margin="0,10,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button x:Name="BtnConfigRojo" Grid.Column="0" Content="Rojo: A" FontSize="20" Height="60" Margin="5" Click="BtnConfigRojo_Click" Background="#220000" Foreground="White" BorderBrush="#FF1A1A"/>
                        <Button x:Name="BtnConfigAzul" Grid.Column="1" Content="Azul: L" FontSize="20" Height="60" Margin="5" Click="BtnConfigAzul_Click" Background="#000022" Foreground="White" BorderBrush="#1A3AFF"/>
                        <Button x:Name="BtnConfigReinicio" Grid.Column="2" Content="Reinicio: R" FontSize="20" Height="60" Margin="5" Click="BtnConfigReinicio_Click" Background="#111" Foreground="White" BorderBrush="#39FF14"/>
                    </Grid>

                    <Button Content="CERRAR CONFIGURACIÓN" Height="70" FontSize="24" Background="#39FF14" Foreground="Black" Click="BtnCerrarConfig_Click" FontWeight="Bold" Margin="0,40,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
