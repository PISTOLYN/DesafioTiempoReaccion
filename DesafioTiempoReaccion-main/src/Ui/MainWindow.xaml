<Window x:Class="DesafioTiempoReaccion.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DesafioTiempoReaccion.Ui"
        Title="Desafío Tiempo de Reacción" Width="1280" Height="760" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        FontFamily="Segoe UI Black" Background="#030615">

    <Window.Resources>
        <DropShadowEffect x:Key="GlowRojo" Color="#FF2A2A" BlurRadius="36" ShadowDepth="0" Opacity="0.85"/>
        <DropShadowEffect x:Key="GlowAzul" Color="#2F7BFF" BlurRadius="36" ShadowDepth="0" Opacity="0.85"/>
        <DropShadowEffect x:Key="GlowVerde" Color="#9CFF2E" BlurRadius="20" ShadowDepth="0" Opacity="0.75"/>
        <DropShadowEffect x:Key="GlowCian" Color="#3C9CFF" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#3C9CFF"/>
            <Setter Property="Background" Value="#0B1B45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2" CornerRadius="10" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B3C94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#081030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CfgTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0B1B45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3C9CFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0A1640" Offset="0"/>
                <GradientStop Color="#030615" Offset="0.6"/>
                <GradientStop Color="#02040C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- ================= JUEGO PRINCIPAL ================= -->
        <Viewbox Stretch="Uniform">
            <Grid Width="1920" Height="1080" ClipToBounds="True">

                <!-- Ambiente de estadio -->
                <Canvas IsHitTestVisible="False">
                    <Polygon Points="0,0 340,0 1010,780 560,780">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.55,1">
                                <GradientStop Color="#3A5AA9FF" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                    </Polygon>
                    <Polygon Points="1920,0 1580,0 910,780 1360,780">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0.45,1">
                                <GradientStop Color="#3A5AA9FF" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                    </Polygon>
                    <Ellipse Canvas.Left="460" Canvas.Top="860" Width="1000" Height="300">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#552E7BFF" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Focos esquina izquierda -->
                    <Ellipse Canvas.Left="14"  Canvas.Top="14" Width="46" Height="46" Fill="White" Effect="{StaticResource GlowCian}"/>
                    <Ellipse Canvas.Left="84"  Canvas.Top="4"  Width="40" Height="40" Fill="White" Effect="{StaticResource GlowCian}"/>
                    <Ellipse Canvas.Left="150" Canvas.Top="18" Width="34" Height="34" Fill="#E8F2FF" Effect="{StaticResource GlowCian}"/>
                    <!-- Focos esquina derecha -->
                    <Ellipse Canvas.Left="1860" Canvas.Top="14" Width="46" Height="46" Fill="White" Effect="{StaticResource GlowCian}"/>
                    <Ellipse Canvas.Left="1796" Canvas.Top="4"  Width="40" Height="40" Fill="White" Effect="{StaticResource GlowCian}"/>
                    <Ellipse Canvas.Left="1736" Canvas.Top="18" Width="34" Height="34" Fill="#E8F2FF" Effect="{StaticResource GlowCian}"/>
                </Canvas>

                <!-- ================= TÍTULO ================= -->
                <Grid Width="780" Height="236" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                    <Path Data="M 70,0 L 710,0 L 780,60 L 780,176 L 710,236 L 70,236 L 0,176 L 0,60 Z"
                          Fill="#CC050C2A" Stroke="#3C9CFF" StrokeThickness="5" StrokeLineJoin="Round" Effect="{StaticResource GlowCian}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="DESAFÍO" FontSize="84" LineHeight="84" LineStackingStrategy="BlockLineHeight"
                                   FontStyle="Italic" TextAlignment="Center" Foreground="White">
                            <TextBlock.Effect><DropShadowEffect Color="#1B3DFF" BlurRadius="0" ShadowDepth="6" Direction="300" Opacity="1"/></TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtTituloJuego" Text="TIEMPO DE REACCIÓN" FontSize="50" LineHeight="54" LineStackingStrategy="BlockLineHeight"
                                   FontStyle="Italic" TextAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFF07A" Offset="0"/>
                                    <GradientStop Color="#FFB300" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <TextBlock.Effect><DropShadowEffect Color="#8A3A00" BlurRadius="0" ShadowDepth="5" Direction="300" Opacity="1"/></TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="CHALLENGE" FontSize="62" LineHeight="64" LineStackingStrategy="BlockLineHeight"
                                   FontStyle="Italic" TextAlignment="Center" Foreground="White">
                            <TextBlock.Effect><DropShadowEffect Color="#1B3DFF" BlurRadius="0" ShadowDepth="5" Direction="300" Opacity="1"/></TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                
                <!-- ===== MARCADOR Rojo ===== -->
                <Grid x:Name="MarcadorRojo" Width="300" Height="160" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="70,34,0,0"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="ScaleMarcadorRojo" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                    <Border Margin="0,30,0,0" CornerRadius="14" BorderThickness="3" BorderBrush="#FF8A8A" Effect="{StaticResource GlowRojo}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#E61C1C" Offset="0"/>
                                <GradientStop Color="#7A0A0A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="TxtPuntosRojo" Text="0" Foreground="White" FontSize="84" FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="3" Opacity="0.7"/></TextBlock.Effect>
                        </TextBlock>
                    </Border>
                    <Border Width="150" Height="40" VerticalAlignment="Top" CornerRadius="8" Background="#1E0303" BorderBrush="#FF8A8A" BorderThickness="2">
                        <TextBlock Text="PUNTO" Foreground="White" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- ===== PANEL Rojo ===== -->
                <Grid x:Name="PanelRojo" Width="660" Height="780" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,256,0,0">
                    <Path Data="M 0,70 L 70,0 L 590,0 L 660,70 L 660,710 L 590,780 L 70,780 L 0,710 Z"
                          Stroke="#FF3A3A" StrokeThickness="6" StrokeLineJoin="Round" Effect="{StaticResource GlowRojo}">
                        <Path.Fill>
                            <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.85" RadiusY="0.85">
                                <GradientStop Color="#6B0A0A" Offset="0"/>
                                <GradientStop Color="#1E0303" Offset="1"/>
                            </RadialGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Margin="21,21,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                          Data="M 0,52 L 52,0 L 566,0 L 618,52 L 618,686 L 566,738 L 52,738 L 0,686 Z"
                          Stroke="#FF8A8A" StrokeThickness="2" Opacity="0.35" StrokeLineJoin="Round"/>

                    <!-- Cabecera -->
                    <Grid Width="560" Height="92" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0">
                        <Path Data="M 40,0 L 520,0 L 560,46 L 520,92 L 40,92 L 0,46 Z" Stroke="#FF8A8A" StrokeThickness="3" StrokeLineJoin="Round">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E61C1C" Offset="0"/>
                                    <GradientStop Color="#7A0A0A" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <TextBlock Text="EQUIPO ROJO" Foreground="White" FontSize="54" FontStyle="Italic"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="4" Opacity="0.8"/></TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                    <!-- Display de tiempo del equipo -->
                    <Border Width="570" Height="190" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,150,0,0"
                            CornerRadius="16" Background="#030508" BorderBrush="#FF3A3A" BorderThickness="4">
                        <ui:SevenSegmentDisplay x:Name="DispRojo" Height="118" Margin="26,0" Text="00.00"
                                                OnBrush="#B8FF3F" OffBrush="#16260C" Effect="{StaticResource GlowVerde}"/>
                    </Border>

                    <!-- Botón físico -->
                    <Grid Width="310" Height="310" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,362,0,0"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="ScaleBtnRojo" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Ellipse Width="310" Height="310" Stroke="#222222" StrokeThickness="2" Effect="{StaticResource GlowRojo}">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FAFAFA" Offset="0"/>
                                    <GradientStop Color="#7A7A7A" Offset="0.45"/>
                                    <GradientStop Color="#E4E4E4" Offset="0.75"/>
                                    <GradientStop Color="#5A5A5A" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="282" Height="282" Fill="#1A0505"/>
                        <Ellipse Width="262" Height="262">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.4,0.3" GradientOrigin="0.35,0.25" RadiusX="0.75" RadiusY="0.75">
                                    <GradientStop Color="#FFA0A0" Offset="0"/>
                                    <GradientStop Color="#FF1E1E" Offset="0.5"/>
                                    <GradientStop Color="#8A0000" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="170" Height="80" VerticalAlignment="Top" Margin="0,46,0,0">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#AAFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="TxtKeyRojo" Text="A" Foreground="White" Opacity="0.55" FontSize="120"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Opacity="0.6"/></TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                    <!-- Placa inferior -->
                    <Grid Width="500" Height="66" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,694,0,0">
                        <Path Data="M 30,0 L 470,0 L 500,33 L 470,66 L 30,66 L 0,33 Z" Fill="#5A0909" Stroke="#FF3A3A" StrokeThickness="3" StrokeLineJoin="Round"/>
                        <TextBlock x:Name="TxtPlacaRojo" Text="PRESIONA EL BOTÓN" Foreground="White" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                
                <!-- ===== MARCADOR Azul ===== -->
                <Grid x:Name="MarcadorAzul" Width="300" Height="160" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,34,70,0"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="ScaleMarcadorAzul" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                    <Border Margin="0,30,0,0" CornerRadius="14" BorderThickness="3" BorderBrush="#8FC0FF" Effect="{StaticResource GlowAzul}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#1F5FFF" Offset="0"/>
                                <GradientStop Color="#0A2A8A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="TxtPuntosAzul" Text="0" Foreground="White" FontSize="84" FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="3" Opacity="0.7"/></TextBlock.Effect>
                        </TextBlock>
                    </Border>
                    <Border Width="150" Height="40" VerticalAlignment="Top" CornerRadius="8" Background="#030818" BorderBrush="#8FC0FF" BorderThickness="2">
                        <TextBlock Text="PUNTO" Foreground="White" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- ===== PANEL Azul ===== -->
                <Grid x:Name="PanelAzul" Width="660" Height="780" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,256,30,0">
                    <Path Data="M 0,70 L 70,0 L 590,0 L 660,70 L 660,710 L 590,780 L 70,780 L 0,710 Z"
                          Stroke="#2F7BFF" StrokeThickness="6" StrokeLineJoin="Round" Effect="{StaticResource GlowAzul}">
                        <Path.Fill>
                            <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.85" RadiusY="0.85">
                                <GradientStop Color="#0A1F6B" Offset="0"/>
                                <GradientStop Color="#030818" Offset="1"/>
                            </RadialGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Margin="21,21,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                          Data="M 0,52 L 52,0 L 566,0 L 618,52 L 618,686 L 566,738 L 52,738 L 0,686 Z"
                          Stroke="#8FC0FF" StrokeThickness="2" Opacity="0.35" StrokeLineJoin="Round"/>

                    <!-- Cabecera -->
                    <Grid Width="560" Height="92" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0">
                        <Path Data="M 40,0 L 520,0 L 560,46 L 520,92 L 40,92 L 0,46 Z" Stroke="#8FC0FF" StrokeThickness="3" StrokeLineJoin="Round">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1F5FFF" Offset="0"/>
                                    <GradientStop Color="#0A2A8A" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <TextBlock Text="EQUIPO AZUL" Foreground="White" FontSize="54" FontStyle="Italic"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="4" Opacity="0.8"/></TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                    <!-- Display de tiempo del equipo -->
                    <Border Width="570" Height="190" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,150,0,0"
                            CornerRadius="16" Background="#030508" BorderBrush="#2F7BFF" BorderThickness="4">
                        <ui:SevenSegmentDisplay x:Name="DispAzul" Height="118" Margin="26,0" Text="00.00"
                                                OnBrush="#B8FF3F" OffBrush="#16260C" Effect="{StaticResource GlowVerde}"/>
                    </Border>

                    <!-- Botón físico -->
                    <Grid Width="310" Height="310" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,362,0,0"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="ScaleBtnAzul" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Ellipse Width="310" Height="310" Stroke="#222222" StrokeThickness="2" Effect="{StaticResource GlowAzul}">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FAFAFA" Offset="0"/>
                                    <GradientStop Color="#7A7A7A" Offset="0.45"/>
                                    <GradientStop Color="#E4E4E4" Offset="0.75"/>
                                    <GradientStop Color="#5A5A5A" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="282" Height="282" Fill="#050A1A"/>
                        <Ellipse Width="262" Height="262">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.4,0.3" GradientOrigin="0.35,0.25" RadiusX="0.75" RadiusY="0.75">
                                    <GradientStop Color="#A8D0FF" Offset="0"/>
                                    <GradientStop Color="#1E64FF" Offset="0.5"/>
                                    <GradientStop Color="#00208A" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="170" Height="80" VerticalAlignment="Top" Margin="0,46,0,0">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#AAFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="TxtKeyAzul" Text="L" Foreground="White" Opacity="0.55" FontSize="120"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Opacity="0.6"/></TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                    <!-- Placa inferior -->
                    <Grid Width="500" Height="66" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,694,0,0">
                        <Path Data="M 30,0 L 470,0 L 500,33 L 470,66 L 30,66 L 0,33 Z" Fill="#09205A" Stroke="#2F7BFF" StrokeThickness="3" StrokeLineJoin="Round"/>
                        <TextBlock x:Name="TxtPlacaAzul" Text="PRESIONA EL BOTÓN" Foreground="White" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>


                <!-- ================= PANEL CENTRAL ================= -->
                <Grid Width="500" Height="780" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,256,0,0">

                    <!-- Etiqueta + display central -->
                    <Grid Height="50" VerticalAlignment="Top">
                        <Path Data="M 24,0 L 476,0 L 500,25 L 476,50 L 24,50 L 0,25 Z" Fill="#0A2A6E" Stroke="#3C9CFF" StrokeThickness="3" StrokeLineJoin="Round"/>
                        <TextBlock x:Name="TxtEtiquetaCentral" Text="TIEMPO DE REACCIÓN" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="170" VerticalAlignment="Top" Margin="0,66,0,0" CornerRadius="16" Background="#030508"
                            BorderBrush="#3C9CFF" BorderThickness="4" Effect="{StaticResource GlowCian}">
                        <ui:SevenSegmentDisplay x:Name="DispCentral" Height="112" Margin="26,0" Text="00.00"
                                                OnBrush="#B8FF3F" OffBrush="#16260C" Effect="{StaticResource GlowVerde}"/>
                    </Border>

                    <!-- Caja de señal / mensajes -->
                    <Border x:Name="CajaSenal" Height="290" VerticalAlignment="Top" Margin="0,256,0,0" CornerRadius="18"
                            BorderThickness="4" BorderBrush="#3C9CFF" Background="#553C9CFF">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
                            <Grid Width="84" Height="84" Margin="0,0,0,8">
                                <Ellipse Stroke="White" StrokeThickness="6" Margin="4,10,4,4"/>
                                <Rectangle Width="24" Height="9" Fill="White" RadiusX="2" RadiusY="2" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                <Rectangle Width="5" Height="28" Fill="White" VerticalAlignment="Top" HorizontalAlignment="Center"
                                           Margin="0,17,0,0" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><RotateTransform x:Name="ManoReloj" Angle="0"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Ellipse Width="11" Height="11" Fill="White" VerticalAlignment="Top" Margin="0,40,0,0"/>
                            </Grid>
                            <TextBlock x:Name="TxtMensaje" Text="ESPERA LA SEÑAL" Foreground="White" FontSize="28" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtSub" Text="Pulsa ESPACIO para comenzar" Foreground="#DDE8FF" FontSize="20" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Modo de juego (decorativo: solo existe un modo) -->
                    <Border Height="110" VerticalAlignment="Top" Margin="0,566,0,0" CornerRadius="14" Background="#CC050C2A"
                            BorderBrush="#3C9CFF" BorderThickness="3">
                        <Grid Margin="14,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="⚙  MODO DE JUEGO" Foreground="White" FontSize="22" Margin="2,0,0,6"/>
                            <Border Grid.Row="1" CornerRadius="10" Background="#0B1B45" BorderBrush="#3C9CFF" BorderThickness="2">
                                <Grid>
                                    <Border Width="64" HorizontalAlignment="Left" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="ModoAnterior_Click" ToolTip="Cambiar modo (TAB)">
                                        <Polygon Points="0,13 15,0 15,26" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="TxtModo" Text="TIEMPO DE REACCIÓN" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Width="64" HorizontalAlignment="Right" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="ModoSiguiente_Click" ToolTip="Cambiar modo (TAB)">
                                        <Polygon Points="15,13 0,0 0,26" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Botones de control -->
                    <UniformGrid Columns="3" Height="54" VerticalAlignment="Top" Margin="0,696,0,0">
                        <Button Content="▶ INICIAR" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="BtnIniciar_Click" ToolTip="ESPACIO"/>
                        <Button Content="↺ REINICIAR" Style="{StaticResource ChipButton}" Margin="5,0" Click="BtnReiniciar_Click" ToolTip="Tecla de reinicio"/>
                        <Button Content="⚙ CONFIG" Style="{StaticResource ChipButton}" Margin="5,0,0,0" Click="BtnConfig_Click" ToolTip="F1"/>
                    </UniformGrid>
                    <TextBlock x:Name="TxtAyuda" Text="ESPACIO iniciar · TAB modo · F1 config · F11 pantalla" Foreground="#7F93C7" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- ================= CONFIGURACIÓN ================= -->
        <Grid x:Name="PantallaConfig" Background="#EE030615" Panel.ZIndex="200" Visibility="Collapsed">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Border Width="820" Height="880" Background="#0A1233" BorderBrush="#3C9CFF" BorderThickness="3" CornerRadius="20"
                        Effect="{StaticResource GlowCian}">
                    <StackPanel Margin="40,28">
                        <TextBlock Text="CONFIGURACIÓN" Foreground="#B8FF3F" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                        <TextBlock Text="Título (línea amarilla):" Foreground="White" FontSize="20"/>
                        <TextBox x:Name="TxtCfgTitulo" Style="{StaticResource CfgTextBox}" MaxLength="28" Margin="0,4,0,14"/>

                        <TextBlock Text="Tiempo límite para presionar tras la señal (segundos, 3-60):" Foreground="White" FontSize="20"/>
                        <TextBox x:Name="TxtCfgLimite" Style="{StaticResource CfgTextBox}" MaxLength="2" Width="120" HorizontalAlignment="Left" Margin="0,4,0,14"/>

                        <TextBlock Text="Botones físicos (haz clic en la caja y presiona la tecla):" Foreground="White" FontSize="20" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Rojo" Foreground="#FF6A6A" FontSize="20"/>
                                <TextBox x:Name="KeyRojo" Style="{StaticResource CfgTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         TextAlignment="Center" Cursor="Hand" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock Text="Azul" Foreground="#6AA6FF" FontSize="20"/>
                                <TextBox x:Name="KeyAzul" Style="{StaticResource CfgTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         TextAlignment="Center" Cursor="Hand" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="Reinicio" Foreground="White" FontSize="20"/>
                                <TextBox x:Name="KeyReinicio" Style="{StaticResource CfgTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         TextAlignment="Center" Cursor="Hand" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Música de fondo (MP3) del modo Tiempo Objetivo:" Foreground="White" FontSize="20" Margin="0,18,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtCfgMusica" Text="(ninguna)" Foreground="#B8FF3F" FontSize="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="ELEGIR…" Style="{StaticResource ChipButton}" Width="130" Height="46" Margin="8,0" Click="BtnElegirMusica_Click"/>
                            <Button Grid.Column="2" Content="QUITAR" Style="{StaticResource ChipButton}" Width="120" Height="46" Click="BtnQuitarMusica_Click"/>
                        </Grid>

                        <TextBlock x:Name="TxtCfgAviso" Text="" Foreground="#FFD21F" FontSize="18" Margin="0,14,0,0" TextWrapping="Wrap" MinHeight="48"/>

                        <Button Content="GUARDAR Y CERRAR" Style="{StaticResource ChipButton}" Height="64" FontSize="24" Margin="0,16,0,0"
                                Background="#1E64FF" Click="BtnCerrarConfig_Click"/>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ================= PANTALLA DE INICIO ================= -->
        <Grid x:Name="PantallaInicio" Panel.ZIndex="300" MouseLeftButtonDown="PantallaInicio_MouseDown">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#16327A" Offset="0"/>
                    <GradientStop Color="#030615" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Viewbox Stretch="Uniform">
                <StackPanel Width="1600" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="DESAFÍO" FontSize="170" FontStyle="Italic" TextAlignment="Center" Foreground="White">
                        <TextBlock.Effect><DropShadowEffect Color="#1B3DFF" BlurRadius="0" ShadowDepth="10" Direction="300" Opacity="1"/></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="TxtTituloInicio" Text="TIEMPO DE REACCIÓN" FontSize="100" FontStyle="Italic" TextAlignment="Center" Foreground="#FFD21F">
                        <TextBlock.Effect><DropShadowEffect Color="#8A3A00" BlurRadius="0" ShadowDepth="8" Direction="300" Opacity="1"/></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="CHALLENGE" FontSize="120" FontStyle="Italic" TextAlignment="Center" Foreground="White">
                        <TextBlock.Effect><DropShadowEffect Color="#1B3DFF" BlurRadius="0" ShadowDepth="8" Direction="300" Opacity="1"/></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="PRESIONA ENTER PARA INICIAR" Foreground="#FFD21F" FontSize="54" TextAlignment="Center" Margin="0,70,0,0">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.8" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </StackPanel>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
