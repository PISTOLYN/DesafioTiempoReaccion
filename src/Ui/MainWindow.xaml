<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DesafioTiempoReaccion.Ui"
        x:Class="DesafioTiempoReaccion.Ui.MainWindow"
        Title="Desafío Tiempo de Reacción" Width="1280" Height="870" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        FontFamily="Segoe UI Black" Background="#030615">

    <Window.Resources>
        <DropShadowEffect x:Key="GlowRojo" Color="#FF2A2A" BlurRadius="36" ShadowDepth="0" Opacity="0.85"/>
        <DropShadowEffect x:Key="GlowAzul" Color="#2F7BFF" BlurRadius="36" ShadowDepth="0" Opacity="0.85"/>
        <DropShadowEffect x:Key="GlowVerde" Color="#9CFF2E" BlurRadius="20" ShadowDepth="0" Opacity="0.75"/>
        <DropShadowEffect x:Key="GlowCian" Color="#3C9CFF" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#3C9CFF"/>
            <Setter Property="Background" Value="#0B1B45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2" CornerRadius="10" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B3C94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#081030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CfgTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0B1B45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3C9CFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0A1640" Offset="0"/>
                <GradientStop Color="#030615" Offset="0.6"/>
                <GradientStop Color="#02040C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- ================= JUEGO PRINCIPAL ================= -->
        <Viewbox Stretch="Uniform">
            <Grid Width="1559" Height="1009" ClipToBounds="True">
                <Image Source="/Assets/fondo.png" Width="1559" Height="1009" Stretch="Fill"/>

            <Grid x:Name="MarcadorRojo" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,84,0,0" Width="126" Height="68" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="ScaleMarcadorRojo" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                <TextBlock x:Name="TxtPuntosRojo" Text="0" Foreground="White" FontSize="62" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="3" Opacity="0.7"/></TextBlock.Effect>
                </TextBlock>
            </Grid>

            <Grid x:Name="MarcadorAzul" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1285,84,0,0" Width="120" Height="68" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="ScaleMarcadorAzul" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                <TextBlock x:Name="TxtPuntosAzul" Text="0" Foreground="White" FontSize="62" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="3" Opacity="0.7"/></TextBlock.Effect>
                </TextBlock>
            </Grid>

            <ui:SevenSegmentDisplay x:Name="DispRojo" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,380,0,0" Width="400" Height="140" Text="00:00.00"
                                    OnBrush="#C6FF2E" OffBrush="#0F1A07" Effect="{StaticResource GlowVerde}"/>

            <ui:SevenSegmentDisplay x:Name="DispAzul" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1070,380,0,0" Width="400" Height="140" Text="00:00.00"
                                    OnBrush="#C6FF2E" OffBrush="#0F1A07" Effect="{StaticResource GlowVerde}"/>

            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="135,575,0,0" Width="300" Height="300" IsHitTestVisible="False">
                <Ellipse x:Name="PulsoRojo" Width="236" Height="236" Fill="White" Opacity="0"/>
                <TextBlock x:Name="TxtKeyRojo" Text="1" Foreground="White" Opacity="0.55" FontSize="96"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0">
                    <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Opacity="0.6"/></TextBlock.Effect>
                </TextBlock>
                <Grid x:Name="BadgeRojo" Visibility="Collapsed">
                    <Ellipse Width="236" Height="236" Fill="#B0000000"/>
                    <TextBlock Text="¡DETENIDO!" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1120,575,0,0" Width="300" Height="300" IsHitTestVisible="False">
                <Ellipse x:Name="PulsoAzul" Width="236" Height="236" Fill="White" Opacity="0"/>
                <TextBlock x:Name="TxtKeyAzul" Text="2" Foreground="White" Opacity="0.55" FontSize="96"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0">
                    <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Opacity="0.6"/></TextBlock.Effect>
                </TextBlock>
                <Grid x:Name="BadgeAzul" Visibility="Collapsed">
                    <Ellipse Width="236" Height="236" Fill="#B0000000"/>
                    <TextBlock Text="¡DETENIDO!" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

                <!-- Centro: etiqueta y display del objetivo -->
                <Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="630,306,0,0" Width="295" Height="44" Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock x:Name="TxtEtiquetaCentral" Text="TIEMPO OBJETIVO" Foreground="White" FontSize="28" TextAlignment="Center"/>
                </Viewbox>
                <ui:SevenSegmentDisplay x:Name="DispCentral" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="648,378,0,0" Width="260" Height="102" Text="05:00"
                                        OnBrush="#C6FF2E" OffBrush="#0F1A07" Effect="{StaticResource GlowVerde}"/>

                <!-- Caja de señal / mensajes -->
                <Border x:Name="CajaSenal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="612,550,0,0" Width="336" Height="192" CornerRadius="12" BorderThickness="3" BorderBrush="#3C9CFF" Background="#553C9CFF">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
                        <Viewbox Width="50" Height="50" Margin="0,0,0,4">
                            <Grid Width="84" Height="84">
                                <Ellipse Stroke="White" StrokeThickness="6" Margin="4,10,4,4"/>
                                <Rectangle Width="24" Height="9" Fill="White" RadiusX="2" RadiusY="2" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                <Rectangle Width="5" Height="28" Fill="White" VerticalAlignment="Top" HorizontalAlignment="Center"
                                           Margin="0,17,0,0" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><RotateTransform x:Name="ManoReloj" Angle="0"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Ellipse Width="11" Height="11" Fill="White" VerticalAlignment="Top" Margin="0,40,0,0"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="TxtMensaje" Text="AJUSTA EL TIEMPO" Foreground="White" FontSize="22" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="316"/>
                        <TextBlock x:Name="TxtSub" Text="" Foreground="#DDE8FF" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="316" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Selector (◀ ▶) -->
                <Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="650,884,0,0" Width="255" Height="44" Stretch="Uniform" StretchDirection="DownOnly" IsHitTestVisible="False">
                    <TextBlock x:Name="TxtModo" Text="OBJETIVO 05:00" Foreground="White" FontSize="30" TextAlignment="Center"/>
                </Viewbox>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="588,872,0,0" Width="62" Height="68" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="ModoAnterior_Click" ToolTip="Menos tiempo (←)"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="905,872,0,0" Width="70" Height="68" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="ModoSiguiente_Click" ToolTip="Más tiempo (→)"/>

                <!-- Controles -->
                <UniformGrid Columns="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="590,956,0,0" Width="385" Height="38">
                    <Button Content="▶ INICIAR" FontSize="13" Style="{StaticResource ChipButton}" Margin="0,0,4,0" Click="BtnIniciar_Click" ToolTip="ESPACIO"/>
                    <Button Content="↺ REINICIAR" FontSize="13" Style="{StaticResource ChipButton}" Margin="4,0" Click="BtnReiniciar_Click" ToolTip="Tecla de reinicio"/>
                    <Button Content="⚙ CONFIG" FontSize="13" Style="{StaticResource ChipButton}" Margin="4,0,0,0" Click="BtnConfig_Click" ToolTip="F1 · F11 pantalla completa · TAB cambia de modo"/>
                </UniformGrid>
            </Grid>
        </Viewbox>

        <!-- ================= CONFIGURACIÓN ================= -->
        <Grid x:Name="PantallaConfig" Background="#EE030615" Panel.ZIndex="200" Visibility="Collapsed">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Border Width="820" Height="880" Background="#0A1233" BorderBrush="#3C9CFF" BorderThickness="3" CornerRadius="20"
                        Effect="{StaticResource GlowCian}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,28">
                        <TextBlock Text="CONFIGURACIÓN" Foreground="#B8FF3F" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                        <TextBlock Text="Título (línea amarilla):" Foreground="White" FontSize="20"/>
                        <TextBox x:Name="TxtCfgTitulo" Style="{StaticResource CfgTextBox}" MaxLength="28" Margin="0,4,0,14"/>

                        <TextBlock Text="Tiempo límite para presionar tras la señal (segundos, 3-60):" Foreground="White" FontSize="20"/>
                        <TextBox x:Name="TxtCfgLimite" Style="{StaticResource CfgTextBox}" MaxLength="2" Width="120" HorizontalAlignment="Left" Margin="0,4,0,14"/>

                        <TextBlock Text="Margen de acierto del modo Tiempo Objetivo (segundos, ±):" Foreground="White" FontSize="20"/>
                        <TextBox x:Name="TxtCfgMargen" Style="{StaticResource CfgTextBox}" MaxLength="5" Width="120" HorizontalAlignment="Left" Margin="0,4,0,14"/>

                        <TextBlock Text="Botones físicos (haz clic en la caja y presiona la tecla):" Foreground="White" FontSize="20" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Rojo" Foreground="#FF6A6A" FontSize="20"/>
                                <TextBox x:Name="KeyRojo" Style="{StaticResource CfgTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         TextAlignment="Center" Cursor="Hand" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock Text="Azul" Foreground="#6AA6FF" FontSize="20"/>
                                <TextBox x:Name="KeyAzul" Style="{StaticResource CfgTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         TextAlignment="Center" Cursor="Hand" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="Reinicio" Foreground="White" FontSize="20"/>
                                <TextBox x:Name="KeyReinicio" Style="{StaticResource CfgTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         TextAlignment="Center" Cursor="Hand" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Música de fondo (MP3) del modo Tiempo Objetivo:" Foreground="White" FontSize="20" Margin="0,18,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtCfgMusica" Text="(ninguna)" Foreground="#B8FF3F" FontSize="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="ELEGIR…" Style="{StaticResource ChipButton}" Width="130" Height="46" Margin="8,0" Click="BtnElegirMusica_Click"/>
                            <Button Grid.Column="2" Content="QUITAR" Style="{StaticResource ChipButton}" Width="120" Height="46" Click="BtnQuitarMusica_Click"/>
                        </Grid>

                        <CheckBox x:Name="ChkVoz" Content="Usar voz en la cuenta regresiva y para anunciar al ganador" Foreground="White" FontSize="20" Margin="0,18,0,0" Focusable="False"/>

                        <TextBlock Text="Efectos de sonido (por defecto o tus propios MP3):" Foreground="White" FontSize="20" Margin="0,18,0,8"/>
                        <StackPanel x:Name="PanelSonidos"/>

                        <TextBlock x:Name="TxtCfgAviso" Text="" Foreground="#FFD21F" FontSize="18" Margin="0,14,0,0" TextWrapping="Wrap" MinHeight="48"/>

                        <Button Content="GUARDAR Y CERRAR" Style="{StaticResource ChipButton}" Height="64" FontSize="24" Margin="0,16,0,0"
                                Background="#1E64FF" Click="BtnCerrarConfig_Click"/>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ================= PANTALLA DE INICIO ================= -->
        <Grid x:Name="PantallaInicio" Panel.ZIndex="300" MouseLeftButtonDown="PantallaInicio_MouseDown">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#16327A" Offset="0"/>
                    <GradientStop Color="#030615" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Viewbox Stretch="Uniform">
                <StackPanel Width="1600" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="DESAFÍO" FontSize="170" FontStyle="Italic" TextAlignment="Center" Foreground="White">
                        <TextBlock.Effect><DropShadowEffect Color="#1B3DFF" BlurRadius="0" ShadowDepth="10" Direction="300" Opacity="1"/></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="TxtTituloInicio" Text="TIEMPO DE REACCIÓN" FontSize="100" FontStyle="Italic" TextAlignment="Center" Foreground="#FFD21F">
                        <TextBlock.Effect><DropShadowEffect Color="#8A3A00" BlurRadius="0" ShadowDepth="8" Direction="300" Opacity="1"/></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="CHALLENGE" FontSize="120" FontStyle="Italic" TextAlignment="Center" Foreground="White">
                        <TextBlock.Effect><DropShadowEffect Color="#1B3DFF" BlurRadius="0" ShadowDepth="8" Direction="300" Opacity="1"/></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="PRESIONA ENTER PARA INICIAR" Foreground="#FFD21F" FontSize="54" TextAlignment="Center" Margin="0,70,0,0">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.8" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </StackPanel>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
